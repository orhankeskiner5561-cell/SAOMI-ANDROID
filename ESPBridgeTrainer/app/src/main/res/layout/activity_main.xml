<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ESP Bridge Trainer" android:textSize="25sp" android:textStyle="bold" />
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Hazır. Uyumlu oyunları tara." />
        <Button android:id="@+id/scanButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Uyumlu Oyunları Tara" />
        <Spinner android:id="@+id/gameSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <Button android:id="@+id/pairButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Oyunu Eşleştir" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Script Editörü" android:textSize="18sp" android:textStyle="bold" />
        <EditText android:id="@+id/scriptEditor" android:layout_width="match_parent" android:layout_height="220dp" android:gravity="top|start" android:inputType="textMultiLine|textNoSuggestions" android:padding="12dp" android:text="radar on&#10;distance on&#10;enemy_color green&#10;max_distance 250" />
        <Button android:id="@+id/runButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Scripti Çalıştır" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Radar Önizleme" android:textSize="18sp" android:textStyle="bold" />
        <com.orhan.esptrainer.RadarView android:id="@+id/radarView" android:layout_width="match_parent" android:layout_height="320dp" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/logText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Log:" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESP Bridge Trainer v3"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hazır. Telefonda oyunları tara." />

        <Button
            android:id="@+id/scanButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Telefondaki Oyunları Tara" />

        <Spinner
            android:id="@+id/gameSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Bağlantı Modu"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/modeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/endpointInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Local API örn: http://127.0.0.1:8765/enemies"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/jsonInput"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:gravity="top|start"
            android:hint="Manuel JSON: {&quot;enemies&quot;:[{&quot;x&quot;:10,&quot;z&quot;:20,&quot;distance&quot;:22}]}"
            android:inputType="textMultiLine|textNoSuggestions" />

        <Button
            android:id="@+id/pairButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Oyunu Eşleştir / Veriyi Al" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Pine-benzeri Script Editörü"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/scriptEditor"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:gravity="top|start"
            android:inputType="textMultiLine|textNoSuggestions"
            android:padding="12dp"
            android:text="//@version=1&#10;radar(true)&#10;distance(true)&#10;enemy_color(&quot;green&quot;)&#10;max_distance(250)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/runButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Scripti Çalıştır" />

            <Button
                android:id="@+id/pasteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Yapıştır" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Kaynak Kod Görüntüleyici"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/sourceSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/loadSourceButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kaynağı Göster" />

        <EditText
            android:id="@+id/sourceViewer"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:gravity="top|start"
            android:inputType="textMultiLine|textNoSuggestions"
            android:scrollbars="vertical"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/copySourceButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kaynağı Kopyala" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Radar"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.orhan.esptrainer.RadarView
            android:id="@+id/radarView"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Log:" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090B10"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:letterSpacing="0.18"
        android:text="ŞAOMİ"
        android:textColor="#D9AD4A"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Hazırım Orhan Bey"
        android:textColor="#F4F4F5"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/heardText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:minHeight="52dp"
        android:text="Konuşmak için mikrofona dokunun"
        android:textColor="#9398A6"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/listenButton"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_marginTop="22dp"
        android:backgroundTint="#D9AD4A"
        android:text="KONUŞ"
        android:textColor="#111318"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cameraButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Fotoğraf" />

        <Space android:layout_width="14dp" android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/videoButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Video" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/enrollVoiceButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="18dp"
        android:text="Sesimi Tanıt" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/wakeButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:text="Şaomi ile Uyandır: Kapalı" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/modelButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="Komutları Öğret"
        android:textColor="#D9AD4A" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/notificationAccessButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="Mesaj Okuma İzni" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/accessibilityAccessButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="24dp"
        android:text="Telefon Kontrol İzni" />
</LinearLayout>
</ScrollView>
